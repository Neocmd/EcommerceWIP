@model ShoppingCart
@{
    ViewData["Title"] = "GetUserCart";
}

<div style="width:90%;margin:auto" class="mt-2">
    @if (TempData["CartError"] is string cartError && !string.IsNullOrWhiteSpace(cartError))
    {
        <div class="alert alert-danger" role="alert">@cartError</div>
    }

    @if (TempData["CartSuccess"] is string cartSuccess && !string.IsNullOrWhiteSpace(cartSuccess))
    {
        <div class="alert alert-success" role="alert">@cartSuccess</div>
    }

    @if (Model != null && Model.CartDetails != null && Model.CartDetails.Count > 0)
    {
        <h5>My Cart</h5>

        <table class="table table-striped">
            <tr>
                <th>Book</th>
                <th>Image</th>
                <th>Genre</th>
                <th>Unit Price</th>
                <th>Total Price</th>
                <th>Action</th>
            </tr>
            @foreach (var item in Model.CartDetails)
            {
                <tr>
                    <td>@item.Book.BookName</td>
                    <td>
                        @if (string.IsNullOrEmpty(item.Book.Image))
                        {
                            <img src="/images/NoImage.png" style="width:80px;height:100px" alt="No image" />
                        }
                        else
                        {
                            <img src="/images/@item.Book.Image" style="width:80px;height:100px" alt="@item.Book.BookName" />
                        }
                    </td>
                    <td>@item.Book.Genre.GenreName</td>
                    <td>@item.Book.Price x @item.Quantity</td>
                    <td>@(item.Book.Price * item.Quantity)</td>
                    <td>
                        <a class="btn btn-info" asp-controller="Cart" asp-action="AddItem" asp-route-bookId="@item.BookId" asp-route-redirect="1">+</a>
                        <a class="btn btn-info" asp-controller="Cart" asp-action="RemoveItem" asp-route-bookId="@item.BookId">-</a>
                    </td>
                </tr>
            }
        </table>

        <div class="my-2">
            <h5>Total:</h5>
            @(Model.CartDetails.Select(item => item.Book.Price * item.Quantity).Sum())
        </div>

        <div class="my-2">
            <a class="btn btn-primary" asp-controller="Cart" asp-action="Checkout">Checkout</a>
        </div>
    }
    else
    {
        <h5>Cart is empty</h5>
    }
</div>
